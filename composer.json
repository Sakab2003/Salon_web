{
    "name": "nasirkhan/laravel-starter",
    "description": "A CMS like modular Laravel starter project.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "alexusmai/laravel-file-manager": "^3.0",
        "dompdf/dompdf": "^2.0",
        "guzzlehttp/guzzle": "^7.4",
        "hashids/hashids": "^4.1",
        "laracasts/flash": "^3.2",
        "laravel-notification-channels/onesignal": "^2.5",
        "laravel-notification-channels/webpush": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.7",
        "lavary/laravel-menu": "^1.8",
        "livewire/livewire": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mews/purifier": "^3.3 || ^4.0",
        "nasirkhan/module-manager": "^0.4.0",
        "nwidart/laravel-modules": "^11.0",
        "orangehill/iseed": "^3.0",
        "predis/predis": "^1.1 || ^2.0",
        "razorpay/razorpay": "2.*",
        "spatie/laravel-activitylog": "^4.5",
        "spatie/laravel-backup": "^8.1",
        "spatie/laravel-html": "^3.1",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-webhook-client": "^3.1",
        "spatie/laravel-webhook-server": "^3.4",
        "stripe/stripe-php": "^10.14 || ^13.0 || ^14.0",
        "yajra/laravel-datatables": "^11.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.13 || ^3.0",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.8",
        "laravel/breeze": "^2.0",
        "laravel/dusk": "^8.0",
        "laravel/pint": "^1.3",
        "laravel/sail": "^1.0.1",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        },

        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "clear-all": [
            "composer dumpautoload -o",
            "@php artisan clear-compiled",
            "@php artisan cache:clear",
            "@php artisan route:clear",
            "@php artisan view:clear",
            "@php artisan config:clear",
            "@php artisan cache:forget spatie.permission.cache"
        ],
        "fix-cs-dry": [
            "vendor/bin/php-cs-fixer fix -vvv --dry-run --show-progress=dots"
        ],
        "fix-cs": [
            "vendor/bin/php-cs-fixer fix -vvv --show-progress=dots"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope",
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
